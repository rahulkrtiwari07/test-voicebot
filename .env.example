# --- LiveKit Cloud (same project as the NDR voicebot) ---
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Outbound SIP trunk (Plivo) — same trunk ID ndr-api uses. Leave blank to use
# browser test calls only.
SIP_TRUNK_ID=
# Worker name the API dispatches to. Distinct from the NDR bot's "my-agent"
# so the two workers never pick up each other's jobs.
AGENT_NAME=vap-agent

# --- Model providers ---
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
SARVAM_API_KEY=
# Only needed if an agent is configured with llm_provider=openai
OPENAI_API_KEY=

# --- Platform ---
# Local docker-compose Postgres (see docker-compose.yml, host port 5434)
DATABASE_URL=postgresql://vap:vap_local_dev@localhost:5434/vap
# Where the worker reaches the API (internal endpoints)
PLATFORM_API_URL=http://localhost:8080
# Shared secret between worker and API for /internal/* endpoints
INTERNAL_API_SECRET=change-me
# Model used for post-call extraction / summary / outcome
POSTCALL_MODEL=gemini-2.5-flash
